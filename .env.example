# Copy to .env. Every value has a safe local default.
IMBUTO_ENV=development            # production turns on the checks below
IMBUTO_DB_PATH=data/imbuto.sqlite
IMBUTO_PHONE_HASH_KEY=change-me   # required in production: HMAC key for phone numbers
IMBUTO_GATEWAY_TOKEN=             # required in production: shared secret for SMS/USSD/voice webhooks
IMBUTO_OPS_TOKEN=                 # required in production: protects /ops and /metrics
IMBUTO_SMS_PROVIDER=console       # console writes to the outbox table; add an adapter per aggregator
